# 의존성
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js 빌드 산출물
.next/
out/
build/

# 프로덕션 번들
dist/

# 테스트 / 커버리지
coverage/
*.lcov

# 환경변수 (.env.example 만 커밋한다)
.env
.env.*
!.env.example

# Prisma — 생성 코드와 로컬 DB 는 추적하지 않는다
**/src/generated/
**/prisma/*.db
**/prisma/*.db-journal
*.sqlite
*.sqlite3

# TypeScript 증분 빌드 캐시
*.tsbuildinfo

# Next 가 만들고 다시 쓰는 파일 — 명령마다 내용이 바뀐다
# (next dev 는 .next/dev/types, build·typegen 은 .next/types 를 가리킨다)
next-env.d.ts

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# 에디터 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 배포
.vercel
