# 이 파일을 .env 로 복사하면 그대로 돌아갑니다.
#   cp .env.example .env

# --- 필수 ---
# SQLite 파일 위치. 경로는 프로젝트 루트 기준.
DATABASE_URL="file:./prisma/dev.db"

# --- 배포 시 필수 ---
# 세션 쿠키(JWT) 서명 키. 비워두면 개발용 고정 키로 떨어지고,
# NODE_ENV=production 에서는 실행을 거부합니다.
#   생성 예: openssl rand -base64 32
SESSION_SECRET=""

# --- 선택 ---
# 없으면 키워드·글자수 기반 규칙 생성기로 퀘스트를 만듭니다.
ANTHROPIC_API_KEY=""

# 없으면 메일 내용을 서버 콘솔에 출력하고 MailLog 에만 저장합니다.
# HOST / USER / PASS 세 개가 모두 있어야 실제 발송을 시도합니다.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# 스트릭의 "하루" 기준 타임존. 기본값 Asia/Seoul.
APP_TIMEZONE="Asia/Seoul"
