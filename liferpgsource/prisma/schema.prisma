// 첫 삽 — 데이터 모델
// 변경 후: npx prisma migrate dev --name <설명>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  tasks Task[]
}

/// 미루고 있는 일 하나. 등록할 때 사용자가 정하는 건 제목 한 줄뿐이다.
model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  emoji String // 사용자가 고르지 않는다. 고르는 순간 그것도 결정이 된다.

  createdAt DateTime  @default(now())
  /// 완료는 선택적 후속이다. 앱이 먼저 묻지 않는다.
  doneAt    DateTime?

  touches Touch[]
  steps   Step[]

  @@index([userId, doneAt])
}

/// 손댄 기록. 한 번이 아니라 여러 번 쌓인다 —
/// 이 간격이 줄어드는 것이 이 앱의 진짜 지표다.
model Touch {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  at         DateTime @default(now())
  /// 이 시작에 이르기까지 몇 번 더 쪼갰는지. 인정 문장을 쓸 때의 재료.
  splitCount Int      @default(0)

  @@index([taskId, at])
}

/// 쪼갠 조각. depth 가 「이것도 버거워」를 누른 횟수다.
model Step {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  text      String
  depth     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId, depth])
}
